{
  "name": "visual-algos",
  "version": "0.1.18",
  "private": true,
  "description": "Desktop app that turns almost any topic into a 3Blue1Brown-style Manim video, rendered locally.",
  "author": "Vizuals",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "setup:python": "node scripts/setup-python-runtime.mjs",
    "package": "npm run setup:python && electron-vite build && electron-builder",
    "package:dir": "npm run setup:python && electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.454.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=20"
  }
}
