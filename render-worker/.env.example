# Render worker environment (Cloud Run service variables).

# Shared secret — MUST match functions/.env RENDER_SHARED_SECRET.
RENDER_SHARED_SECRET=

# Firebase Storage bucket, e.g. your-project-id.appspot.com
RENDER_BUCKET=

# Max seconds a single Manim render may run before being killed.
RENDER_TIMEOUT_SECONDS=600

# Local only: port for `python main.py` (Cloud Run sets PORT automatically).
PORT=8081
