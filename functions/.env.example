# Copy to functions/.env  (loaded automatically by Firebase Functions v2)
#
# Google AI Studio (Gemini) API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model used to write the Manim scene.
GEMINI_MODEL=gemini-2.5-flash

# HTTPS URL of the deployed Cloud Run render worker (see render-worker/).
# Example: https://manim-render-worker-abc123-uc.a.run.app
# Leave blank when running locally; the emulator falls back to
# http://127.0.0.1:8081 (see RENDER_WORKER_URL_LOCAL usage in index.ts).
RENDER_WORKER_URL=

# Shared secret sent to the render worker in the X-Render-Token header so the
# worker only accepts jobs from this function. Must match the worker's
# RENDER_SHARED_SECRET.
RENDER_SHARED_SECRET=
